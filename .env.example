# Copy to .env and fill in locally. .env is gitignored.
# Used at build time only — never ship raw secrets inside the APK.
# See docs/PROJECT_IDEA.md § «Безпека та ключі».

# --- Build / release (optional; can also use upload-keystore.properties) ---
# PLAY_UPLOAD_STORE_FILE=../keystore/upload.jks
# PLAY_UPLOAD_STORE_PASSWORD=
# PLAY_UPLOAD_KEY_ALIAS=
# PLAY_UPLOAD_KEY_PASSWORD=

# --- App encryption (SQLCipher / field-level) ---
# 32-byte key as Base64 or hex; generate once per install or derive in-app — see docs
# APP_DB_ENCRYPTION_KEY_BASE64=

# --- Integrity / attestation (optional, future) ---
# SAFETYNET_API_KEY=
